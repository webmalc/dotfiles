-- minuet-ai.nvim with Ollama (Qwen2.5-Coder:7B) and blink.cmp integration
return {
  {
    "milanglacier/minuet-ai.nvim",
    dependencies = { "nvim-lua/plenary.nvim" }, -- Required for HTTP
    config = function()
      require("minuet").setup({
        -- Provider: OpenAI-FIM compatible for Ollama's completions endpoint
        provider = "openai_fim_compatible",
        -- Number of parallel completions (keep low for local models)
        n_completions = 1,
        -- Context window: Start small for speed; increase to 2048+ if your hardware allows
        context_window = 512,
        request_timeout = 3, -- Seconds before aborting slow requests
        -- throttle = 1500,      -- ms between requests (tune for your GPU)
        debounce = 200, -- ms delay before triggering on typing
        -- Ollama-specific options
        provider_options = {
          openai_fim_compatible = {
            api_key = "TERM", -- Placeholder; uses $TERM env var
            name = "Ollama",
            end_point = "http://localhost:11434/v1/completions",
            model = "qwen2.5-coder:7b",
            optional = {
              max_tokens = 56, -- Concise for inline; increase for longer suggestions
              top_p = 0.9, -- Nucleus sampling for variety
              -- temperature = 0.1, -- Low for deterministic code
            },
          },
        },
      })
    end,
  },
}
